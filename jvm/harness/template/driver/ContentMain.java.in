{{package}}

{{import BuiltInRegistries}}
{{import BLOCK}}

public final class ContentMain {

    private ContentMain() {
    }

    public static void main(String[] args) {
        {{BuiltInRegistries}}.{{registry.built-in-freeze#freeze}}();
        System.out.println({{BuiltInRegistries}}.{{BuiltInRegistries#BLOCK}}.contents());
        System.out.println({{BuiltInRegistries}}.{{BuiltInRegistries#ITEM}}.contents());
        System.out.println("states=" + {{BLOCK}}.{{BLOCK#BLOCK_STATE_REGISTRY}}.size()
                + " cached=" + {{BLOCK}}.{{BLOCK#BLOCK_STATE_REGISTRY}}.cached());
        System.out.println("hooks=" + dev.ravel.jvm.Hook.nativeInvocations());
    }
}
