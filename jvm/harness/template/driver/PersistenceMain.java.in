{{package}}

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Comparator;
import java.util.List;
import java.util.stream.Stream;
{{import CREATE_WORLD_SCREEN}}
{{import LEVEL_STORAGE_ACCESS}}
{{import MINECRAFT}}
{{import PACK_REPOSITORY}}
{{import SERVER}}
{{import STORAGE}}
{{import WORLD_STEM}}
{{import world.create-pack-repository}}

public final class PersistenceMain {

    private PersistenceMain() {
    }

    public static void main(String[] args) throws IOException {
        {{STORAGE}}.seed(
                System.getProperty("ravel.test.persistence.stored", "").isEmpty()
                        ? null
                        : System.getProperty("ravel.test.persistence.stored").getBytes());

        emptyTree(Path.of("world"));
        emptyTree(STAGING);

        List<String> enabled = List.of("vanilla");
        if (RESTAGED.contains(STAGING_ANSWER)) {
            Path pack = STAGING.resolve("ravel");
            Files.createDirectories(pack);
            Files.writeString(pack.resolve(dev.ravel.jvm.Hook.PACK_FILE), SEEDED_CONTENTS);
            enabled = List.of("vanilla", "file/ravel");
        }

        {{CREATE_WORLD_SCREEN}} screen = new {{CREATE_WORLD_SCREEN}}(STAGING, enabled);
        screen.{{screen.create-world-init#init}}();
        screen.{{screen.create-world-init#init}}();
        System.out.println("staged=" + where(dev.ravel.jvm.Hook.stagedDirectory())
                + " stagedWrites=" + dev.ravel.jvm.Hook.stagedWrites()
                + " screenLoads=" + screen.loads()
                + " loaded=" + screen.loaded());
        if (Boolean.getBoolean("ravel.test.persistence.screenOnly")) {
            return;
        }

        {{LEVEL_STORAGE_ACCESS}} access = new {{LEVEL_STORAGE_ACCESS}}("world");
        {{WORLD_STEM}} stem = new {{WORLD_STEM}}();

        screen.copyInto(Path.of("world", "datapacks"));

        {{PACK_REPOSITORY}} packs =
                {{world.create-pack-repository}}.{{world.create-pack-repository#createPackRepository}}(access);
        System.out.println("datapack=" + dev.ravel.jvm.Hook.datapackWorld()
                + " loadsAtWrite=" + {{MINECRAFT}}.loads()
                + " available=" + {{world.create-pack-repository}}.available());

        {{MINECRAFT}}.{{MINECRAFT#getInstance}}().openWorld(access, packs, stem);
        System.out.println("loads=" + {{MINECRAFT}}.loads()
                + " accessClosed=" + access.isClosed()
                + " stemClosed=" + stem.isClosed()
                + " crossed=" + dev.ravel.jvm.Hook.openCrossings()
                + " read=" + dev.ravel.jvm.Hook.openAggregate());

        new {{SERVER}}().{{world.save-persistence#saveAllChunks}}(false, false, false);
        System.out.println("saves=" + {{SERVER}}.saves()
                + " writes=" + {{STORAGE}}.writes()
                + " written=" + {{STORAGE}}.written());
    }

    private static final Path STAGING = Path.of("staging").toAbsolutePath();

    private static final String STAGING_ANSWER =
            System.getProperty("ravel.test.persistence.staging", "written");

    private static final List<String> RESTAGED = List.of("unchanged", "replaced");

    private static final String SEEDED_CONTENTS = "old";

    private static String where(String directory) {
        if (directory.isEmpty()) {
            return "none";
        }
        return STAGING.equals(Path.of(directory)) ? "screen" : "elsewhere";
    }

    private static void emptyTree(Path root) throws IOException {
        if (!Files.exists(root)) {
            return;
        }
        try (Stream<Path> tree = Files.walk(root)) {
            for (Path entry : tree.sorted(Comparator.reverseOrder()).toList()) {
                Files.delete(entry);
            }
        }
    }
}
