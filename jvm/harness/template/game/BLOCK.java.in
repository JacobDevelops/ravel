{{package}}

{{import IDENTIFIER}}
{{import ID_MAPPER}}
{{import STATE_DEFINITION}}
{{import BlockBehaviour$Properties}}

public class {{BLOCK}} {

    public static final {{ID_MAPPER}} {{BLOCK#BLOCK_STATE_REGISTRY}} = new {{ID_MAPPER}}();

    private final String applied;
    private final {{STATE_DEFINITION}} states;
    private {{IDENTIFIER}} identifier;

    public {{BLOCK}}({{BlockBehaviour$Properties}} properties) {
        this.applied = properties.applied();
        this.states = new {{STATE_DEFINITION}}("default", "alternate");
    }

    public {{STATE_DEFINITION}} {{BLOCK#getStateDefinition}}() {
        if (String.valueOf(identifier).endsWith("unmappable")) {
            throw new IllegalStateException("this block's states cannot be listed");
        }
        return states;
    }

    public void named({{IDENTIFIER}} identifier) {
        this.identifier = identifier;
    }

    public {{IDENTIFIER}} name() {
        return identifier;
    }

    public String applied() {
        return applied;
    }
}
