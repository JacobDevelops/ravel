{{package}}

{{import DefaultedRegistry}}

/**
 * The built-in registries, with the internal name, member and descriptor the
 * pinned inventory carries for the seam that closes them.
 */
public final class {{BuiltInRegistries}} {
    public static final {{DefaultedRegistry}} {{BuiltInRegistries#BLOCK}} =
            new {{DefaultedRegistry}}("block");
    public static final {{DefaultedRegistry}} {{BuiltInRegistries#ITEM}} =
            new {{DefaultedRegistry}}("item");

    private {{BuiltInRegistries}}() {
    }

    /** The last point new content can be added, which is why the prologue is here. */
    public static void {{registry.built-in-freeze#freeze}}() {
        {{BuiltInRegistries#BLOCK}}.close();
        {{BuiltInRegistries#ITEM}}.close();
    }
}
