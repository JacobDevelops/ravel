{{package}}

import com.mojang.datafixers.util.Pair;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.function.Consumer;
import java.util.stream.Stream;
{{import PACK_REPOSITORY}}
{{import WORLD_CREATION_CONTEXT}}
{{import WORLD_CREATION_UI_STATE}}
{{import WORLD_DATA_CONFIGURATION}}

public final class {{CREATE_WORLD_SCREEN}} {

    private final List<String> loaded = new ArrayList<>();

    private final Path staging;
    private final {{WORLD_CREATION_UI_STATE}} uiState;

    private final {{PACK_REPOSITORY}} stagingRepository;
    private int loads;

    public {{CREATE_WORLD_SCREEN}}(Path staging, List<String> enabled) {
        this.staging = staging;
        {{WORLD_DATA_CONFIGURATION}} configuration = new {{WORLD_DATA_CONFIGURATION}}(enabled);
        uiState = new {{WORLD_CREATION_UI_STATE}}(new {{WORLD_CREATION_CONTEXT}}(configuration));
        stagingRepository = new {{PACK_REPOSITORY}}(staging);
        stagingRepository.{{PACK_REPOSITORY#reload}}();
        stagingRepository.{{PACK_REPOSITORY#setSelected}}(enabled);
        load(stagingRepository, configuration);
    }

    public List<String> loaded() {
        return List.copyOf(loaded);
    }

    public int loads() {
        return loads;
    }

    public {{WORLD_CREATION_UI_STATE}} {{CREATE_WORLD_SCREEN#getUiState}}() {
        return uiState;
    }

    public void {{screen.create-world-init#init}}() {
    }

    private Pair<Path, {{PACK_REPOSITORY}}> {{CREATE_WORLD_SCREEN#getDataPackSelectionSettings}}(
            {{WORLD_DATA_CONFIGURATION}} configuration) throws IOException {
        Files.createDirectories(staging);
        stagingRepository.{{PACK_REPOSITORY#reload}}();
        stagingRepository.{{PACK_REPOSITORY#setSelected}}(configuration.enabled());
        return Pair.of(staging, stagingRepository);
    }

    // Discovery and selection stay separate so omitting either loses staged data.
    private void {{CREATE_WORLD_SCREEN#tryApplyNewDataPacks}}(
            {{PACK_REPOSITORY}} repository, boolean confirmExperimental, Consumer<Object> onRefused) {
        List<String> enabled = List.copyOf(repository.{{PACK_REPOSITORY#getSelectedIds}}());
        {{CREATE_WORLD_SCREEN#applyNewPackConfig}}(
                repository, new {{WORLD_DATA_CONFIGURATION}}(enabled), onRefused);
    }

    private void {{CREATE_WORLD_SCREEN#applyNewPackConfig}}(
            {{PACK_REPOSITORY}} repository,
            {{WORLD_DATA_CONFIGURATION}} configuration,
            Consumer<Object> onRefused) {
        load(repository, configuration);
    }

    private void load({{PACK_REPOSITORY}} repository, {{WORLD_DATA_CONFIGURATION}} configuration) {
        uiState.setSettings(new {{WORLD_CREATION_CONTEXT}}(configuration));
        loads++;
        loaded.clear();
        for (String id : configuration.enabled()) {
            String contents = repository.contents(id);
            loaded.add(contents.isEmpty() ? id : id + "=" + contents);
        }
    }

    public void copyInto(Path worldPacks) throws IOException {
        Files.createDirectories(worldPacks);
        try (Stream<Path> tree = Files.walk(staging)) {
            for (Path entry : tree.filter(path -> !path.equals(staging)).sorted().toList()) {
                Path destination = worldPacks.resolve(staging.relativize(entry).toString());
                if (Files.isDirectory(entry)) {
                    Files.createDirectories(destination);
                } else {
                    Files.copy(entry, destination);
                }
            }
        }
    }
}
