{{package}}

import java.util.ArrayList;
import java.util.List;
{{import BLOCK_STATE_BASE}}

public final class {{ID_MAPPER}} {

    private final List<Object> entries = new ArrayList<>();

    public void {{ID_MAPPER#add}}(Object entry) {
        entries.add(entry);
    }

    public int size() {
        return entries.size();
    }

    public int cached() {
        int cached = 0;
        for (Object entry : entries) {
            if (entry instanceof {{BLOCK_STATE_BASE}} state && state.isCached()) {
                cached++;
            }
        }
        return cached;
    }
}
