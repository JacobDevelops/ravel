{{package}}

import java.nio.file.Path;
{{import LEVEL_RESOURCE}}

public final class {{LEVEL_STORAGE_ACCESS}} implements AutoCloseable {

    private final String world;
    private boolean closed;

    public {{LEVEL_STORAGE_ACCESS}}(String world) {
        this.world = world;
    }

    public Path {{LEVEL_STORAGE_ACCESS#getLevelPath}}({{LEVEL_RESOURCE}} resource) {
        return Path.of(world, resource.id());
    }

    public boolean isClosed() {
        return closed;
    }

    @Override
    public void close() {
        closed = true;
    }
}
