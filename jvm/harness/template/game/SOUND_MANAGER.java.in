{{package}}

import java.util.ArrayList;
import java.util.List;
{{import SOUND_INSTANCE}}
{{import SOUND_PLAY_RESULT}}

public final class {{SOUND_MANAGER}} {

    private final List<String> played = new ArrayList<>();

    public {{SOUND_PLAY_RESULT}} {{SOUND_MANAGER#play}}({{SOUND_INSTANCE}} sound) {
        played.add(sound.toString());
        return {{SOUND_PLAY_RESULT}}.STARTED;
    }

    public String contents() {
        return String.join(",", played);
    }
}
