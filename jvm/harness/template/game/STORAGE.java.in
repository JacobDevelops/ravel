{{package}}

import com.mojang.datafixers.DataFixer;
import java.nio.charset.StandardCharsets;
import java.nio.file.Path;
{{import HOLDER_LOOKUP_PROVIDER}}
{{import SavedData}}
{{import SavedDataType}}

public final class {{STORAGE}} implements AutoCloseable {

    private static byte[] stored;

    private static int writes;
    private static byte[] written;

    public {{STORAGE}}() {
    }

    public {{STORAGE}}(Path directory, DataFixer fixer, {{HOLDER_LOOKUP_PROVIDER}} registries) {
    }

    public static void seed(byte[] aggregate) {
        stored = aggregate;
        writes = 0;
        written = null;
    }

    public static int writes() {
        return writes;
    }

    public static String written() {
        return written == null ? "" : new String(written, StandardCharsets.UTF_8);
    }

    public {{SavedData}} {{STORAGE#get}}({{SavedDataType}} type) {
        return stored == null ? null : new {{SavedData}}(stored);
    }

    public void {{STORAGE#set}}({{SavedDataType}} type, {{SavedData}} data) {
        writes++;
        written = data.aggregate();
    }

    @Override
    public void close() {
    }
}
