{{package}}

import java.util.ArrayList;
import java.util.List;
{{import AbstractContainerEventHandler}}
{{import Component}}
{{import Font}}
{{import GuiEventListener}}
{{import KeyEvent}}

public class {{Screen}} extends {{AbstractContainerEventHandler}} {

    public int {{Screen#width}} = 400;
    public int {{Screen#height}} = 300;
    protected final {{Font}} {{Screen#font}} = new {{Font}}();
    private final List<{{GuiEventListener}}> widgets = new ArrayList<>();
    private final String diagnostic;

    protected {{Screen}}({{Component}} title) {
        this.diagnostic = null;
    }

    public {{Screen}}(String diagnostic) {
        this.diagnostic = diagnostic;
    }

    protected void {{Screen#init}}() {
    }

    protected {{GuiEventListener}} {{Screen#addRenderableWidget}}({{GuiEventListener}} widget) {
        widgets.add(widget);
        return widget;
    }

    protected void clearWidgets() {
        widgets.clear();
    }

    public void clearFocus() {
        {{AbstractContainerEventHandler#setFocused}}(null);
    }

    // Always taking focus makes failed restoration deterministic in the harness.
    protected void setInitialFocus() {
        {{AbstractContainerEventHandler#setFocused}}(widgets.isEmpty() ? null : widgets.get(0));
    }

    // Reset focus on every rebuild to exercise the hostile game behavior.
    protected void {{Screen#rebuildWidgets}}() {
        clearWidgets();
        clearFocus();
        {{Screen#init}}();
        setInitialFocus();
    }

    public List<{{GuiEventListener}}> widgets() {
        return List.copyOf(widgets);
    }

    public boolean {{Screen#keyPressed}}({{KeyEvent}} event) {
        if (event.{{KeyEvent#key}}() == 256) {
            {{Screen#onClose}}();
            return true;
        }
        return false;
    }

    public void {{Screen#onClose}}() {
    }

    public boolean press(int key) {
        return {{Screen#keyPressed}}(new {{KeyEvent}}(key, 0, 0));
    }

    @Override
    public String toString() {
        return diagnostic;
    }
}
