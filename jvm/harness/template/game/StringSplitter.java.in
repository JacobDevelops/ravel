{{package}}

import java.util.ArrayList;
import java.util.List;
{{import FormattedText}}
{{import Style}}

public final class {{StringSplitter}} {

    public static final int ADVANCE = 6;

    public int measure(String text) {
        return text.length() * ADVANCE;
    }

    public List<{{FormattedText}}> {{StringSplitter#splitLines}}(String text, int maxWidth, {{Style}} style) {
        List<{{FormattedText}}> lines = new ArrayList<>();
        StringBuilder line = new StringBuilder();
        for (String word : text.split(" ", -1)) {
            String rest = word;
            while (measure(rest) > maxWidth) {
                if (line.length() > 0) {
                    lines.add(text(line.toString()));
                    line.setLength(0);
                }
                int fits = Math.max(1, maxWidth / ADVANCE);
                lines.add(text(rest.substring(0, fits)));
                rest = rest.substring(fits);
            }
            String candidate = line.length() == 0 ? rest : line + " " + rest;
            if (measure(candidate) <= maxWidth) {
                line.setLength(0);
                line.append(candidate);
            } else {
                lines.add(text(line.toString()));
                line.setLength(0);
                line.append(rest);
            }
        }
        if (line.length() > 0 || lines.isEmpty()) {
            lines.add(text(line.toString()));
        }
        return lines;
    }

    private static {{FormattedText}} text(String line) {
        return () -> line;
    }
}
