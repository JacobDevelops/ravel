{{package}}

{{import AbstractWidget}}
{{import Component}}
{{import Font}}

public final class {{StringWidget}} extends {{AbstractWidget}} {

    private final {{Font}} font;
    private final int x;
    private final int y;
    private final int width;
    private final int height;

    public {{StringWidget}}(int x, int y, int width, int height, {{Component}} message, {{Font}} font) {
        super(message);
        this.font = font;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    public String text() {
        return message().text();
    }

    public boolean fits() {
        return font.{{Font#width}}(text()) <= width;
    }

    public int textX() {
        return x + Math.round(0.5F * (width - font.{{Font#width}}(text())));
    }

    public int x() {
        return x;
    }

    public int y() {
        return y;
    }

    public int height() {
        return height;
    }
}
