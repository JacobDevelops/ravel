{{package}}

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.stream.Stream;
{{import LEVEL_RESOURCE}}
{{import LEVEL_STORAGE_ACCESS}}
{{import PACK_REPOSITORY}}

public final class {{world.create-pack-repository}} {

    private static final List<String> AVAILABLE = new ArrayList<>();

    private {{world.create-pack-repository}}() {
    }

    public static List<String> available() {
        return List.copyOf(AVAILABLE);
    }

    public static {{PACK_REPOSITORY}} {{world.create-pack-repository#createPackRepository}}(
            {{LEVEL_STORAGE_ACCESS}} access) {
        AVAILABLE.clear();
        Path packs = access.{{LEVEL_STORAGE_ACCESS#getLevelPath}}({{LEVEL_RESOURCE}}.{{LEVEL_RESOURCE#ROOT}})
                .resolve("datapacks");
        try (Stream<Path> entries = Files.list(packs)) {
            entries.map(entry -> entry.getFileName().toString()).sorted().forEach(AVAILABLE::add);
        } catch (IOException absent) {
        }
        return new {{PACK_REPOSITORY}}();
    }
}
