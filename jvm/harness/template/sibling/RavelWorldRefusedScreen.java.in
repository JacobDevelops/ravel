{{package}}

{{import Screen}}

/**
 * Stands in for the sibling artifact's world-refusal screen.
 *
 * <p>It exists so the harness models an installation that has one. Without it
 * every refusal in this section reached the path a refusal with nothing to draw
 * takes, which is the launch failure this stand-in's absence is now reserved for:
 * one case removes the jar entirely, and only that one is meant to end in a
 * throw.
 */
public final class RavelWorldRefusedScreen {

    private RavelWorldRefusedScreen() {
    }

    /** The screen a refused world load leaves the player on. */
    public static {{Screen}} open(String diagnostic) {
        return new {{Screen}}(diagnostic);
    }
}
