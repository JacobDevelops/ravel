{{package}}

{{import Screen}}
{{import Component}}

abstract class RavelScrolling extends {{Screen}} {

    RavelScrolling({{Component}} title) {
        super(title);
    }

    abstract boolean scrolled(int key);

    @Override
    public boolean {{Screen#keyPressed}}(int key, int scanCode, int modifiers) {
        return scrolled(key) || super.{{Screen#keyPressed}}(key, scanCode, modifiers);
    }
}
