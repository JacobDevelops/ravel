{{package}}

{{import SavedData}}
{{import SavedDataFactory}}
{{import CompoundTag}}
{{import HolderLookupProvider}}
{{import DataFixTypes}}

public final class RavelWorldData extends {{SavedData}} {

    private static final String NAME = "ravel_mods";

    private static final String FIELD = "aggregate";

    private final byte[] aggregate;

    private RavelWorldData(byte[] aggregate) {
        this.aggregate = aggregate;
    }

    public static Object folder(java.nio.file.Path data) {
        return data.toFile();
    }

    public static Object[] lookup() {
        return new Object[] {type(), NAME};
    }

    public static Object[] replacement(byte[] aggregate) {
        return new Object[] {NAME, of(aggregate)};
    }

    private static {{SavedDataFactory}} type() {
        return new {{SavedDataFactory}}(
                () -> new RavelWorldData(new byte[0]),
                (tag, registries) -> new RavelWorldData(
                        (({{CompoundTag}}) tag).{{CompoundTag#getByteArray}}(FIELD)),
                {{DataFixTypes}}.{{DataFixTypes#SAVED_DATA_COMMAND_STORAGE}});
    }

    @Override
    public {{CompoundTag}} {{SavedData#save}}(
            {{CompoundTag}} tag, {{HolderLookupProvider}} registries) {
        tag.{{CompoundTag#putByteArray}}(FIELD, aggregate);
        return tag;
    }

    // Storage only caches replacements; marking dirty ensures they are saved.
    private static {{SavedData}} of(byte[] aggregate) {
        RavelWorldData held = new RavelWorldData(aggregate);
        held.{{SavedData#setDirty}}();
        return held;
    }

    public static byte[] bytes(Object stored) {
        if (!(stored instanceof RavelWorldData held)) {
            return null;
        }
        return held.aggregate;
    }
}
