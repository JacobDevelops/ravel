{{package}}

import java.util.ArrayList;
import java.util.List;
{{import Font}}
{{import FormattedText}}
{{import Style}}

final class Layout {

    static final int TOP = 32;

    static final int ROW = 22;

    static final int WIDGET_WIDTH = 320;

    static final int WIDGET_HEIGHT = 20;

    static final int TEXT_INSET = 8;

    private Layout() {}

    static int rows(int height, int reserved) {
        return Math.max(1, (height - TOP - reserved * ROW - WIDGET_HEIGHT) / ROW);
    }

    static List<String> wrap({{Font}} font, String text, int width) {
        List<String> lines = new ArrayList<>();
        for ({{FormattedText}} line :
                font.{{Font#getSplitter}}()
                        .{{StringSplitter#splitLines}}(
                                text,
                                width,
                                {{Style}}.{{Style#EMPTY}})) {
            lines.add(line.{{FormattedText#getString}}());
        }
        return lines;
    }
}
