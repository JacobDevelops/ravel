{{package}}

import java.lang.reflect.InvocationTargetException;
import java.lang.reflect.Method;
{{import Minecraft}}
{{import Button}}
{{import Button$OnPress}}
{{import GuiEventListener}}
{{import Screen}}
{{import Component}}

/** Adds Ravel's mod list to the game's normal title-menu button column. */
public final class RavelMenu {

    private static final int BUTTON_WIDTH = 200;
    private static final int BUTTON_HEIGHT = 20;

    private RavelMenu() {
    }

    /** Adds one button immediately after the normal menu options. */
    public static void add(Object receiver, int bottom, int spacing) {
        {{Screen}} title = ({{Screen}}) receiver;
        {{Button}} button = {{Button}}.{{Button#builder}}({{Component}}.{{Component#literal}}("Ravel Mods"), new {{Button$OnPress}}() {
                    @Override
                    public void {{Button$OnPress#onPress}}({{Button}} pressed) {
                        {{Minecraft}}.{{Minecraft#getInstance}}().{{Minecraft#setScreen}}(openMods());
                    }
                })
                .{{Button$Builder#bounds}}((title.{{Screen#width}} - BUTTON_WIDTH) / 2, bottom + spacing, BUTTON_WIDTH, BUTTON_HEIGHT)
                .{{Button$Builder#build}}();
        add(title, button);
    }

    private static {{Screen}} openMods() {
        return open("openMods", new Class<?>[0]);
    }

    /** One mod's settings screen closing back to {@code parent}, or {@code null} if it could not be built. */
    static {{Screen}} openSettings(String owner, {{Screen}} parent) {
        return open("openSettings", new Class<?>[] {String.class, Object.class}, owner, parent);
    }

    /** The profiling screen, closing back to {@code parent}, or {@code null} if it could not be built. */
    static {{Screen}} openProfiling({{Screen}} parent) {
        return open("openProfiling", new Class<?>[] {Object.class}, parent);
    }

    /**
     * Asks the agent jar for a screen.
     *
     * <p>The agent's builder contains every failure a screen class can raise
     * on load and answers {@code null} with a diagnostic, so a screen that
     * cannot be built costs the player the click and not the client.
     */
    private static {{Screen}} open(String name, Class<?>[] types, Object... arguments) {
        try {
            Class<?> screens = Class.forName(
                    "dev.ravel.jvm.Screens", true, ClassLoader.getSystemClassLoader());
            Method open = screens.getDeclaredMethod(name, types);
            open.setAccessible(true);
            return ({{Screen}}) open.invoke(null, arguments);
        } catch (InvocationTargetException failed) {
            Throwable cause = failed.getCause() == null ? failed : failed.getCause();
            throw new IllegalStateException("the Ravel screen could not be opened", cause);
        } catch (ReflectiveOperationException | RuntimeException unusable) {
            throw new IllegalStateException("the Ravel screen entry is unavailable", unusable);
        }
    }

    private static void add({{Screen}} title, {{Button}} button) {
        try {
            Method add = {{Screen}}.class.getDeclaredMethod(
                    "{{Screen#addRenderableWidget}}", {{GuiEventListener}}.class);
            add.setAccessible(true);
            add.invoke(title, button);
        } catch (InvocationTargetException failed) {
            Throwable cause = failed.getCause() == null ? failed : failed.getCause();
            throw new IllegalStateException("the title screen refused Ravel's menu button", cause);
        } catch (ReflectiveOperationException | RuntimeException unusable) {
            throw new IllegalStateException("the title screen cannot accept Ravel's menu button", unusable);
        }
    }
}
