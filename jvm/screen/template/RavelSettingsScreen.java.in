{{package}}

import dev.ravel.jvm.Hook;
import java.util.ArrayList;
import java.util.List;
{{import Minecraft}}
{{import AbstractSliderButton}}
{{import Button}}
// Generated stubs expose nested game types under their binary names.
{{import Button$OnPress}}
{{import EditBox}}
{{import GuiEventListener}}
{{import Screen}}
{{import Component}}

public final class RavelSettingsScreen extends {{Screen}} {

    private static final int TOP = 40;

    private static final int ROW = 24;

    private static final int WIDGET_WIDTH = 200;
    private static final int WIDGET_HEIGHT = 20;

    private final String owner;

    private final List<Row> rows = new ArrayList<>();

    private String refused = "";

    private final {{Screen}} parent;

    private RavelSettingsScreen(String owner, {{Screen}} parent) {
        super({{Component}}.{{Component#translatable}}("ravel.config.title"));
        this.owner = owner;
        this.parent = parent;
        rows.addAll(read(Hook.ravelSettingsDocument(owner)));
    }

    public static {{Screen}} open(String owner) {
        return new RavelSettingsScreen(owner, null);
    }

    public static {{Screen}} open(String owner, Object parent) {
        return new RavelSettingsScreen(owner, ({{Screen}}) parent);
    }

    public String owner() {
        return owner;
    }

    public String refused() {
        return refused;
    }

    @Override
    protected void {{Screen#init}}() {
        super.{{Screen#init}}();
        for (Row row : rows) {
            row.capture();
        }

        int y = TOP;
        for (Row row : rows) {
            {{Screen#addRenderableWidget}}(row.build(this, y));
            y += ROW;
        }
        {{Screen#addRenderableWidget}}(
                {{Button}}.{{Button#builder}}({{Component}}.{{Component#translatable}}("gui.done"), new {{Button$OnPress}}() {
                            @Override
                            public void {{Button$OnPress#onPress}}({{Button}} pressed) {
                                {{Screen#onClose}}();
                            }
                        })
                        .{{Button$Builder#bounds}}(centre(), y + ROW, WIDGET_WIDTH, WIDGET_HEIGHT)
                        .{{Button$Builder#build}}());
    }

    private static List<Row> read(String document) {
        if (document == null) {
            return List.of();
        }
        Wire wire = new Wire(document);
        if (!Wire.VERSION.equals(wire.field()) || wire.field() == null || wire.field() == null) {
            return List.of();
        }
        int count = wire.count();
        if (count < 0) {
            return List.of();
        }
        List<Row> read = new ArrayList<>(count);
        for (int index = 0; index < count; index++) {
            Row row = Row.read(wire);
            if (row == null) {
                return List.of();
            }
            read.add(row);
        }
        return wire.finished() ? read : List.of();
    }

    @Override
    public void {{Screen#onClose}}() {
        List<Row> changed = new ArrayList<>();
        for (Row row : rows) {
            if (row.changed()) {
                changed.add(row);
            }
        }
        StringBuilder edits = new StringBuilder();
        Wire.write(edits, Wire.VERSION);
        Wire.write(edits, owner);
        Wire.write(edits, Integer.toString(changed.size()));
        for (Row row : changed) {
            Wire.write(edits, row.key);
            Wire.write(edits, row.value);
        }
        refused = describe(Hook.ravelSaveSettings(edits.toString()));
        if (parent == null) {
            super.{{Screen#onClose}}();
        } else {
            {{Minecraft}}.{{Minecraft#getInstance}}().{{Minecraft#setScreen}}(parent);
        }
    }

    private static String describe(String answer) {
        if (answer == null) {
            return "";
        }
        Wire wire = new Wire(answer);
        int count = wire.count();
        if (count <= 0) {
            return "";
        }
        StringBuilder said = new StringBuilder();
        for (int index = 0; index < count; index++) {
            String key = wire.field();
            String reason = wire.field();
            if (key == null || reason == null) {
                return "";
            }
            if (index > 0) {
                said.append("; ");
            }
            said.append(key).append(": ").append(reason);
        }
        return said.toString();
    }

    private int centre() {
        return ({{Screen#width}} - WIDGET_WIDTH) / 2;
    }

    private static double number(String text, double fallback) {
        try {
            return Double.parseDouble(text);
        } catch (NumberFormatException notANumber) {
            return fallback;
        }
    }

    private static final class Row {

        private final String key;
        private final String label;
        private final String widget;
        private final String original;
        private final boolean editable;
        private final boolean restartRequired;
        private final List<String> choices;
        private final double minimum;
        private final double maximum;
        private final boolean whole;

        private String value;
        private {{EditBox}} box;

        private Row(
                String key,
                String label,
                String widget,
                String kind,
                String value,
                boolean editable,
                boolean restartRequired,
                double minimum,
                double maximum,
                List<String> choices) {
            this.key = key;
            this.label = label;
            this.widget = widget;
            this.original = value;
            this.value = value;
            this.editable = editable;
            this.restartRequired = restartRequired;
            this.minimum = minimum;
            this.maximum = maximum;
            this.choices = choices;
            this.whole = "integer".equals(kind);
        }

        static Row read(Wire wire) {
            String key = wire.field();
            String label = wire.field();
            String description = wire.field();
            String widget = wire.field();
            String kind = wire.field();
            String value = wire.field();
            String source = wire.field();
            String editable = wire.field();
            String restartRequired = wire.field();
            String restartPending = wire.field();
            String minimum = wire.field();
            String maximum = wire.field();
            if (key == null
                    || label == null
                    || description == null
                    || widget == null
                    || kind == null
                    || value == null
                    || source == null
                    || editable == null
                    || restartRequired == null
                    || restartPending == null
                    || minimum == null
                    || maximum == null) {
                return null;
            }
            int count = wire.count();
            if (count < 0) {
                return null;
            }
            List<String> choices = new ArrayList<>(count);
            for (int index = 0; index < count; index++) {
                String choice = wire.field();
                if (choice == null) {
                    return null;
                }
                choices.add(choice);
            }
            return new Row(
                    key,
                    label,
                    widget,
                    kind,
                    value,
                    Boolean.parseBoolean(editable),
                    Boolean.parseBoolean(restartRequired),
                    number(minimum, 0),
                    number(maximum, 1),
                    choices);
        }

        private {{GuiEventListener}} build(RavelSettingsScreen screen, int y) {
            int x = screen.centre();
            if (!editable) {
                {{EditBox}} drawn = text(screen, x, y);
                drawn.{{EditBox#setEditable}}(false);
                return drawn;
            }
            switch (widget) {
                case "toggle":
                    return cycle(x, y, List.of("true", "false"));
                case "choice":
                    return cycle(x, y, choices);
                case "slider":
                    return new Slider(this, x, y);
                default:
                    return text(screen, x, y);
            }
        }

        private {{EditBox}} text(RavelSettingsScreen screen, int x, int y) {
            box = new {{EditBox}}(
                    screen.{{Screen#font}}, x, y, WIDGET_WIDTH, WIDGET_HEIGHT, {{Component}}.{{Component#literal}}(caption()));
            box.{{EditBox#setMaxLength}}(1024);
            box.{{EditBox#setValue}}(value);
            return box;
        }

        private {{Button}} cycle(int x, int y, List<String> values) {
            return {{Button}}.{{Button#builder}}({{Component}}.{{Component#literal}}(caption()), new {{Button$OnPress}}() {
                        @Override
                        public void {{Button$OnPress#onPress}}({{Button}} pressed) {
                            if (!values.isEmpty()) {
                                int at = values.indexOf(value);
                                value = values.get((at + 1) % values.size());
                            }
                            pressed.{{AbstractWidget#setMessage}}({{Component}}.{{Component#literal}}(caption()));
                        }
                    })
                    .{{Button$Builder#bounds}}(x, y, WIDGET_WIDTH, WIDGET_HEIGHT)
                    .{{Button$Builder#build}}();
        }

        private String caption() {
            String shown = label + ": " + value;
            if (restartRequired && changed()) {
                return shown + " (next launch)";
            }
            return shown;
        }

        private void capture() {
            if (box != null) {
                value = box.{{EditBox#getValue}}();
                box = null;
            }
        }

        private boolean changed() {
            capture();
            return !value.equals(original);
        }
    }

    private static final class Slider extends {{AbstractSliderButton}} {

        private final Row row;

        Slider(Row row, int x, int y) {
            super(
                    x,
                    y,
                    WIDGET_WIDTH,
                    WIDGET_HEIGHT,
                    {{Component}}.{{Component#literal}}(row.caption()),
                    fraction(row));
            this.row = row;
        }

        private static double fraction(Row row) {
            double span = row.maximum - row.minimum;
            if (span <= 0) {
                return 0;
            }
            double at = number(row.value, row.minimum);
            return Math.min(1, Math.max(0, (at - row.minimum) / span));
        }

        @Override
        protected void {{AbstractSliderButton#updateMessage}}() {
            {{AbstractWidget#setMessage}}({{Component}}.{{Component#literal}}(row.caption()));
        }

        @Override
        protected void {{AbstractSliderButton#applyValue}}() {
            double at = row.minimum + {{AbstractSliderButton#value}} * (row.maximum - row.minimum);
            row.value = row.whole ? Long.toString(Math.round(at)) : Double.toString(at);
        }
    }
}
