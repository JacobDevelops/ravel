{{package}}

{{import Codec}}
{{import Identifier}}
{{import ExtraCodecs}}
{{import DataFixTypes}}
{{import SavedData}}
{{import SavedDataType}}

public final class RavelWorldData extends {{SavedData}} {

    private static final String NAMESPACE = "ravel";
    private static final String PATH = "mods";

    private static final String FIELD = "aggregate";

    private final byte[] aggregate;

    private RavelWorldData(byte[] aggregate) {
        this.aggregate = aggregate;
    }

    public static Object folder(java.nio.file.Path data) {
        return data;
    }

    public static Object[] lookup() {
        return new Object[] {type()};
    }

    public static Object[] replacement(byte[] aggregate) {
        return new Object[] {type(), of(aggregate)};
    }

    private static {{SavedDataType}} type() {
        // Storage requires a compound tag rather than the codec's bare string tag.
        {{Codec}} codec = {{ExtraCodecs}}.{{ExtraCodecs#BASE64_STRING}}
                .{{Codec#xmap}}(stored -> new RavelWorldData((byte[]) stored),
                        data -> ((RavelWorldData) data).aggregate)
                .{{Codec#fieldOf}}(FIELD)
                .{{MapCodec#codec}}();
        return new {{SavedDataType}}(
                {{Identifier}}.{{Identifier#fromNamespaceAndPath}}(NAMESPACE, PATH),
                () -> new RavelWorldData(new byte[0]),
                codec,
                {{DataFixTypes}}.{{DataFixTypes#SAVED_DATA_COMMAND_STORAGE}});
    }

    // Some versions only cache replacements; marking dirty ensures they are saved.
    private static {{SavedData}} of(byte[] aggregate) {
        RavelWorldData held = new RavelWorldData(aggregate);
        held.{{SavedData#setDirty}}();
        return held;
    }

    public static byte[] bytes(Object stored) {
        if (!(stored instanceof RavelWorldData held)) {
            return null;
        }
        return held.aggregate;
    }
}
