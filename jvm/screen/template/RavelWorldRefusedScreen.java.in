{{package}}

{{import Button}}
{{import Button$OnPress}}
{{import EditBox}}
{{import Screen}}
{{import Component}}

public final class RavelWorldRefusedScreen extends {{Screen}} {

    private static final int TOP = 40;
    private static final int ROW = 22;
    private static final int WIDGET_WIDTH = 320;
    private static final int WIDGET_HEIGHT = 20;

    private static final int PER_ROW = 60;

    private static final String ELLIPSIS = "...";

    private static final int MAX_ROWS = 6;

    private final String diagnostic;

    private RavelWorldRefusedScreen(String diagnostic) {
        super({{Component}}.{{Component#translatable}}("ravel.world.refused.title"));
        this.diagnostic = diagnostic == null ? "" : diagnostic;
    }

    public static {{Screen}} open(String diagnostic) {
        return new RavelWorldRefusedScreen(diagnostic);
    }

    public String diagnostic() {
        return diagnostic;
    }

    @Override
    protected void {{Screen#init}}() {
        super.{{Screen#init}}();
        int y = TOP;
        {{Screen#addRenderableWidget}}(label("This world was not opened.", y));
        y += ROW;
        int start = 0;
        for (int rows = 0; start < diagnostic.length() && rows < MAX_ROWS; rows++) {
            int end = Math.min(diagnostic.length(), start + PER_ROW);
            String row = diagnostic.substring(start, end);
            start = end;
            if (start < diagnostic.length() && rows + 1 == MAX_ROWS) {
                row = row.substring(0, Math.max(0, row.length() - ELLIPSIS.length())) + ELLIPSIS;
            }
            {{Screen#addRenderableWidget}}(label(row, y));
            y += ROW;
        }
        {{Screen#addRenderableWidget}}(label("Deleting Ravel's saved data resets Ravel for this world.", y));
        y += ROW;

        {{Screen#addRenderableWidget}}(
                {{Button}}.{{Button#builder}}({{Component}}.{{Component#translatable}}("gui.done"), new {{Button$OnPress}}() {
                            @Override
                            public void {{Button$OnPress#onPress}}({{Button}} pressed) {
                                {{Screen#onClose}}();
                            }
                        })
                        .{{Button$Builder#bounds}}(centre(), y + ROW, WIDGET_WIDTH, WIDGET_HEIGHT)
                        .{{Button$Builder#build}}());
    }

    private {{EditBox}} label(String text, int y) {
        {{EditBox}} box =
                new {{EditBox}}({{Screen#font}}, centre(), y, WIDGET_WIDTH, WIDGET_HEIGHT, {{Component}}.{{Component#literal}}(text));
        box.{{EditBox#setMaxLength}}(1024);
        box.{{EditBox#setValue}}(text);
        box.{{EditBox#setEditable}}(false);
        return box;
    }

    private int centre() {
        return ({{Screen#width}} - WIDGET_WIDTH) / 2;
    }
}
