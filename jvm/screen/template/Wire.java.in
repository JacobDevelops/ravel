{{package}}

final class Wire {

    static final String VERSION = "1";
    static final String SETTINGS_VERSION = "2";

    static final String MODS_VERSION = "4";

    private final String text;
    private int at;

    Wire(String text) {
        this.text = text;
        this.at = 0;
    }

    String field() {
        int separator = text.indexOf(':', at);
        if (separator < 0) {
            return null;
        }
        int length;
        try {
            length = Integer.parseInt(text, at, separator, 10);
        } catch (NumberFormatException notALength) {
            return null;
        }
        int start = separator + 1;
        if (length < 0 || length > text.length() - start) {
            return null;
        }
        at = start + length;
        return text.substring(start, at);
    }

    int count() {
        String read = field();
        if (read == null) {
            return -1;
        }
        try {
            int value = Integer.parseInt(read);
            return value < 0 ? -1 : value;
        } catch (NumberFormatException notACount) {
            return -1;
        }
    }

    boolean finished() {
        return at == text.length();
    }

    static void write(StringBuilder out, String value) {
        out.append(value.length()).append(':').append(value);
    }
}
