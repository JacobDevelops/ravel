{{package}}

import java.lang.reflect.Field;
import java.util.List;
{{import SCREEN}}
{{import LEGACY_TITLE}}
{{import LEGACY_BUTTON}}
{{import LEGACY_CLIENT}}

public final class RavelMenu {
    private RavelMenu() {}

    public static void onOpened(Object screen) {
        if (screen instanceof {{LEGACY_TITLE}}) {
            {{SCREEN}} title = ({{SCREEN}}) screen;
            // The top margin stays clear of vanilla's menu rows at every GUI scale.
            add(title, 4, 0);
        }
    }

    public static void add(Object receiver, int bottom, int spacing) {
        {{SCREEN}} title = ({{SCREEN}}) receiver;
        try {
            List<?> buttons = buttons(title);
            for (Object button : buttons) if (button instanceof ModsButton) return;
            List.class.getMethod("add", Object.class)
                    .invoke(buttons, new ModsButton(title, (title.{{SCREEN#width}} - 200) / 2, bottom + spacing));
        } catch (ReflectiveOperationException failure) {
            throw new IllegalStateException("legacy title menu refused the Ravel entry", failure);
        }
    }

    private static List<?> buttons(Object screen) throws ReflectiveOperationException {
        Field field = {{SCREEN}}.class.getDeclaredField("{{SCREEN#buttons}}");
        field.setAccessible(true);
        return (List<?>) field.get(screen);
    }

    static int entryCount(Object screen) {
        try {
            int count = 0;
            for (Object button : buttons(screen)) if (button instanceof ModsButton) count++;
            return count;
        } catch (ReflectiveOperationException failure) {
            throw new IllegalStateException("legacy title widgets cannot be inspected", failure);
        }
    }

    private static final class ModsButton extends {{LEGACY_BUTTON}} {
        private final {{SCREEN}} parent;
        ModsButton({{SCREEN}} parent, int x, int y) {
            super(-190417, x, y, 200, 20, "Ravel Mods");
            this.parent = parent;
        }
        @Override
        public boolean {{LEGACY_BUTTON#mouseClicked}}({{LEGACY_CLIENT}} client, int x, int y) {
            if (super.{{LEGACY_BUTTON#mouseClicked}}(client, x, y))
                client.{{LEGACY_CLIENT#openScreen}}(RavelModsScreen.open(parent));
            // Opening is handled here; never feed a Ravel id to vanilla's button callback.
            return false;
        }
    }
}
