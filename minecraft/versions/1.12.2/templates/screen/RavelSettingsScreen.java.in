{{package}}

import dev.ravel.jvm.Hook;
import java.util.ArrayList;
import java.util.List;
{{import SCREEN}}

/** A batched native settings session with Java-owned drawing, editing and cancellation. */
public final class RavelSettingsScreen extends LegacyRavelScreen {
    private final String owner;
    private final List<Row> rows = new ArrayList<>();
    private String refused = "";
    private int offset;
    private int focused = -1;
    private int dragging = -1;
    private boolean finished;

    private RavelSettingsScreen(String owner, {{SCREEN}} parent) {
        super(parent);
        this.owner = owner;
        read(Hook.ravelSettingsDocument(owner));
    }

    public static {{SCREEN}} open(String owner) { return open(owner, null); }
    public static {{SCREEN}} open(String owner, Object parent) {
        return new RavelSettingsScreen(owner, ({{SCREEN}}) parent);
    }
    public String owner() { return owner; }
    public String refused() { return refused; }
    public List<String> keys() {
        List<String> keys = new ArrayList<>(rows.size());
        for (Row row : rows) keys.add(row.key);
        return keys;
    }
    public String value(String key) { return row(key).value; }
    public boolean editable(String key) { return row(key).editable; }
    public boolean finished() { return finished; }
    public boolean pausesGame() { return {{SCREEN#shouldPauseGame}}(); }

    private Row row(String key) {
        for (Row row : rows) if (row.key.equals(key)) return row;
        throw new IllegalArgumentException("unknown setting: " + key);
    }

    public boolean edit(String key, String value) {
        Row row = row(key);
        if (finished || !row.editable) return false;
        row.value = value;
        return true;
    }

    /** Reset means discard this session's edits, not invent unavailable schema defaults. */
    public void reset() {
        if (finished) return;
        for (Row row : rows) row.value = row.original;
        refused = "";
    }

    public void cancel() {
        if (finished) return;
        reset();
        finished = true;
    }

    public boolean save() {
        if (finished) return false;
        int count = 0;
        for (Row row : rows) if (row.changed()) count++;
        StringBuilder payload = new StringBuilder();
        Wire.write(payload, Wire.VERSION);
        Wire.write(payload, owner);
        Wire.write(payload, Integer.toString(count));
        for (Row row : rows) if (row.changed()) {
            Wire.write(payload, row.key);
            Wire.write(payload, row.value);
        }
        refused = describe(Hook.ravelSaveSettings(payload.toString()));
        if (!refused.isEmpty()) return false;
        finished = true;
        return true;
    }

    private static String describe(String answer) {
        if (answer == null) return "Settings save did not return a result";
        Wire wire = new Wire(answer);
        int count = wire.count();
        if (count < 0) return "Invalid settings save response";
        StringBuilder message = new StringBuilder();
        for (int index = 0; index < count; index++) {
            String key = wire.field(), reason = wire.field();
            if (key == null || reason == null) return "Invalid settings save response";
            if (index > 0) message.append("; ");
            message.append(key).append(": ").append(reason);
        }
        return wire.finished() ? message.toString() : "Invalid settings save response";
    }

    private void read(String document) {
        if (document == null) { refused = "No settings available"; return; }
        Wire wire = new Wire(document);
        if (!Wire.VERSION.equals(wire.field()) || !owner.equals(wire.field()) || wire.field() == null)
            throw new IllegalArgumentException("invalid settings document header");
        int count = wire.count();
        if (count < 0) throw new IllegalArgumentException("invalid settings row count");
        for (int index = 0; index < count; index++) rows.add(new Row(wire));
        if (!wire.finished()) throw new IllegalArgumentException("trailing settings data");
    }

    @Override
    public void {{SCREEN#render}}(int mouseX, int mouseY, float delta) {
        background("Ravel settings: " + owner);
        int end = Math.min(rows.size(), offset + visibleRows());
        for (int index = offset; index < end; index++) {
            Row row = rows.get(index);
            int y = 36 + (index - offset) * 32;
            String marker = row.editable ? "" : " [locked: " + row.source + "]";
            if (row.restartPending || row.restartRequired && row.changed()) marker += " [next launch]";
            text(row.label + marker, left(), y, row.editable ? 0xFFFFFF : 0xAAAAAA);
            button(row.value + (focused == index ? "_" : ""), left(), y + 10, 300, row.editable);
            if (mouseY >= y && mouseY < y + 32 && !row.description.isEmpty())
                text(row.description, left(), footer() - 12, 0xCCCCCC);
        }
        button("Save", left(), footer(), 94, !finished);
        button("Reset edits", left() + 102, footer(), 94, !finished);
        button("Cancel", left() + 204, footer(), 96, true);
        text("Page Up / Page Down: scroll", left(), footer() + 26, 0xAAAAAA);
        if (!refused.isEmpty()) text(refused, left(), {{SCREEN#height}} - 12, 0xFF8888);
    }

    @Override
    protected void {{SCREEN#mouseClicked}}(int x, int y, int button) {
        if (button != 0 || finished) return;
        if (hit(x, y, left(), footer(), 94)) { if (save()) close(); return; }
        if (hit(x, y, left() + 102, footer(), 94)) { reset(); return; }
        if (hit(x, y, left() + 204, footer(), 96)) { cancel(); close(); return; }
        focused = -1;
        int index = offset + (y - 46) / 32;
        if (y < 46 || index >= rows.size() || index >= offset + visibleRows()) return;
        Row row = rows.get(index);
        if (!row.editable || !hit(x, y, left(), 46 + (index - offset) * 32, 300)) return;
        if ("toggle".equals(row.widget)) edit(row.key, Boolean.toString(!Boolean.parseBoolean(row.value)));
        else if ("choice".equals(row.widget) && !row.choices.isEmpty())
            edit(row.key, row.choices.get((row.choices.indexOf(row.value) + 1) % row.choices.size()));
        else if ("slider".equals(row.widget)) { dragging = index; slide(x); }
        else focused = index;
    }

    private void slide(int x) {
        Row row = rows.get(dragging);
        double fraction = Math.max(0, Math.min(1, (x - left()) / 299.0));
        double value = row.minimum + fraction * (row.maximum - row.minimum);
        edit(row.key, "integer".equals(row.kind) ? Long.toString(Math.round(value)) : Double.toString(value));
    }
    @Override
    protected void {{SCREEN#mouseDragged}}(int x, int y, int button, long duration) {
        if (dragging >= 0 && button == 0) slide(x);
    }
    @Override
    protected void {{SCREEN#mouseReleased}}(int x, int y, int button) { dragging = -1; }

    @Override
    protected void {{SCREEN#keyPressed}}(char character, int key) {
        if (key == 1) { cancel(); close(); return; }
        if (key == 201 || key == 209) {
            offset = Math.max(0, Math.min(Math.max(0, rows.size() - visibleRows()),
                    offset + (key == 201 ? -visibleRows() : visibleRows())));
            focused = -1;
            return;
        }
        if (focused < 0 || finished) return;
        Row row = rows.get(focused);
        if (key == 14 && !row.value.isEmpty()) edit(row.key, row.value.substring(0, row.value.length() - 1));
        else if (character >= 32 && character != 127 && row.value.length() < 1024) edit(row.key, row.value + character);
    }
    @Override
    public void {{SCREEN#removed}}() { if (!finished) cancel(); }

    private static final class Row {
        final String key, label, description, widget, kind, original, source;
        final boolean editable, restartRequired, restartPending;
        final double minimum, maximum;
        final List<String> choices = new ArrayList<>();
        String value;
        Row(Wire wire) {
            key = required(wire); label = required(wire); description = required(wire);
            widget = required(wire); kind = required(wire); original = required(wire);
            value = original; source = required(wire);
            editable = Boolean.parseBoolean(required(wire));
            restartRequired = Boolean.parseBoolean(required(wire));
            restartPending = Boolean.parseBoolean(required(wire));
            minimum = number(required(wire)); maximum = number(required(wire));
            int count = wire.count();
            if (count < 0) throw new IllegalArgumentException("invalid choice count");
            for (int index = 0; index < count; index++) choices.add(required(wire));
        }
        boolean changed() { return editable && !value.equals(original); }
        private static String required(Wire wire) {
            String value = wire.field();
            if (value == null) throw new IllegalArgumentException("incomplete settings row");
            return value;
        }
        private static double number(String value) {
            return value.isEmpty() ? 0 : Double.parseDouble(value);
        }
    }
}
