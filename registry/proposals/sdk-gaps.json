  "vocabulary": {
    "capabilities": {
      "audio-declaration": {
        "anchor": "audio",
        "borders": [
          "content",
          "resources",
          "sides"
        ],
        "boundary": "No audio is reproduced, described, or carried. The proposal is the entry kind and the side rule.",
        "capability": "A mod declares the audio entries it owns and the events that play them, as a declaration whose client half is refused on a server rather than skipped there.",
        "id": "RVL-GAP-03",
        "motivation": {
          "families": [
            "sounds"
          ],
          "rule": "any"
        },
        "tests": [
          {
            "file": "proposals/tests/rvl-gap-03-t1.rs",
            "kind": "declaration-accepted"
          },
          {
            "file": "proposals/tests/rvl-gap-03-t2.rs",
            "kind": "side-refusal"
          }
        ],
        "whyGeneral": "The family clears the threshold across entries whose lanes and rights differ, so it is not one lane's need. The SDK can carry the bytes as a supplied resource, but it has no entry kind for an audio event, so nothing relates the bytes to what plays them and nothing refuses a play call made on the wrong side."
      },
      "behaviour-interception": {
        "anchor": "interception",
        "borders": [
          "events",
          "sides"
        ],
        "boundary": "The proposal is a published set of points with an ordering and a refusal contract. It is not a way to rewrite the game's code, it names no point any entry chose, and it reproduces no entry's behaviour.",
        "capability": "A mod declares that it wants to answer at a named point in the game rather than only to be told what happened there, and Ravel publishes those points, orders the mods at each one, and lets a mod refuse or replace the outcome under a declared contract.",
        "id": "RVL-GAP-05",
        "motivation": {
          "families": [
            "mixinConfigs",
            "accessTransformers"
          ],
          "rule": "any"
        },
        "restraint": "Ravel forbids unsafe code in every maintained crate and this proposal does not ask for an exception. A point is a place the host already calls out from, so an interception is a call the host makes, not a patch a mod applies.",
        "tests": [
          {
            "file": "proposals/tests/rvl-gap-05-t1.rs",
            "kind": "ordering"
          },
          {
            "file": "proposals/tests/rvl-gap-05-t2.rs",
            "kind": "conflict-refused"
          }
        ],
        "whyGeneral": "This is the largest pattern in the inventory by entry count and it spans every lane. The SDK tells a mod what the game did; it has no way for a mod to change what the game is about to do. Nothing about the pattern is one entry's: what differs between entries is which point they want, and a point is exactly what a platform can publish once."
      },
      "library-provision": {
        "anchor": "provision",
        "borders": [
          "services",
          "content"
        ],
        "boundary": "No library is ported, bundled, or named. The proposal is the provider declaration, the resolution, and the two refusals.",
        "capability": "A mod declares that it provides a shared library other mods may build on, at a version, and Ravel resolves one provider per library for a launch and refuses a set where two providers disagree or where a required library has none.",
        "id": "RVL-GAP-06",
        "motivation": {
          "families": [
            "nestedJars"
          ],
          "rule": "any"
        },
        "tests": [
          {
            "file": "proposals/tests/rvl-gap-06-t1.rs",
            "kind": "declaration-accepted"
          },
          {
            "file": "proposals/tests/rvl-gap-06-t2.rs",
            "kind": "conflict-refused"
          }
        ],
        "whyGeneral": "Entries carrying this family are each shipping a copy of something meant to be shared, and the count clears the threshold across lanes. The SDK orders named calls between mods that are both installed, which is a different question from which mod supplies a shared thing and at what version. Nothing today answers the second."
      },
      "render-stage-declaration": {
        "anchor": "render_stages",
        "borders": [
          "resources",
          "sides"
        ],
        "boundary": "No drawing program is written, ported, or described. The proposal is the stage name, the ordering, and the two refusals.",
        "capability": "A mod declares the named drawing stages it contributes to and the order it wants among other mods at each one, and Ravel refuses a cycle and a stage no mod declares rather than resolving either quietly.",
        "id": "RVL-GAP-04",
        "motivation": {
          "families": [
            "shaders"
          ],
          "rule": "any"
        },
        "tests": [
          {
            "file": "proposals/tests/rvl-gap-04-t1.rs",
            "kind": "ordering"
          },
          {
            "file": "proposals/tests/rvl-gap-04-t2.rs",
            "kind": "absent-dependency-refused"
          }
        ],
        "whyGeneral": "The family clears the threshold, and every entry carrying it is doing the same thing structurally: adding work to a stage some other party also draws in. Ordering between mods is what the SDK already solved for named calls between mods, and drawing has none of it."
      },
      "server-data-declaration": {
        "anchor": "server_data",
        "borders": [
          "content",
          "generate",
          "tags"
        ],
