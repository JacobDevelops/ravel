  "rules": {
    "C1-candidate": "A cluster candidate is a pair of admissible entries in the client-presentation, content-data or integration-runtime lanes that share a dependency, closed over dependencies, with every member admissible.",
    "C2-choice": "Among candidates, fewest members outside the foundation set wins; then most distinct owner lanes spanned; then lowest summed riskScore over the new members; then lowest leaf ids.",
    "F1-seed": "A foundation seed is an admissible entry owned by sdk-platform whose rubric foundationValue is 3 or more, which is two or more dependent entries. This rule is exhaustive: every entry in the inventory satisfying it is in the foundation part.",
    "F2-closure": "Anything a foundation seed depends on joins the foundation part.",
    "R0-rights": "An entry whose sourceUse is prohibited or unresolved is excluded outright. A counterpart whose rights position is unresolved is not foundation work.",
    "R1-closure": "Each part is dependency-closed: if an entry is in a part, every id in its dependencies is in that part."
  },
