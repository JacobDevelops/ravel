{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:schema:evidence:1",
  "title": "Ravel milestone evidence manifest",
  "description": "Sanitized, reproducible evidence for one milestone gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "milestone",
    "workPackages",
    "revision",
    "versions",
    "environment",
    "inputs",
    "commands",
    "tests",
    "benchmarks",
    "deviations",
    "risks",
    "review",
    "attestations",
    "platformEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "enum": ["synthetic", "native"],
      "description": "Synthetic documents test the contract; only native documents can close a milestone."
    },
    "milestone": {
      "type": "string",
      "pattern": "^M(?:[0-9]|1[0-3])$"
    },
    "workPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M(?:[0-9]|1[0-3])-W(?:0|[1-9][0-9]*)$"
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dirty"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Commit exercised by the recorded commands; it may precede the revision that admits this manifest, and every jj rewrite abandons it, so it records what ran rather than where to find it."
        },
        "changeId": {
          "type": "string",
          "pattern": "^[k-z]{32}$",
          "description": "Optional historical change identifier retained for compatibility with recorded evidence; the gate does not verify revision ownership."
        },
        "dirty": {
          "type": "boolean",
          "description": "Whether the exercised source tree had uncommitted changes when the commands ran."
        }
      }
    },
    "unobtainableRevisions": {
      "type": "array",
      "description": "Historical disclosures of record pins that were unobtainable when recorded. Retained for compatibility; the gate does not verify pin obtainability or require these disclosures.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record", "id", "reason"],
        "properties": {
          "record": {
            "type": "string",
            "minLength": 1,
            "description": "The benchmarks.results[].name whose trial carries the pin."
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The commit the record pinned when this historical disclosure was written."
          },
          "changeId": {
            "type": "string",
            "pattern": "^[k-z]{32}$",
            "description": "Optional historical change identifier recorded alongside the commit; retained for compatibility without revision ownership verification."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Historical explanation of what a reader lost when this pin was unobtainable."
          }
        }
      }
    },
    "versions": {
      "$ref": "#/$defs/versionSet"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "hardwareProfile", "settings"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "hardwareProfile": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "description": "A closure with no hashed input is bound to no revision at all, and an empty array satisfied every rule phrased as a refusal.",
      "items": {
        "$ref": "#/$defs/hashedArtifact"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "lineCoveragePercent"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "lineCoveragePercent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "results"],
      "properties": {
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashedArtifact"
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classifiedFinding"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classifiedFinding"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "independent", "result"],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "result": {
          "enum": ["pass", "fail", "not-required"]
        },
        "record": {
          "$ref": "#/$defs/reviewRecord"
        }
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "architecture",
          "workloads",
          "statement",
          "attestedBy",
          "attestedAt"
        ],
        "properties": {
          "platform": {
            "enum": ["linux", "macos"]
          },
          "architecture": {
            "enum": ["x86_64", "aarch64"]
          },
          "workloads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["vanilla", "official-atm11", "ravel"]
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "attestedBy": {
            "type": "string",
            "minLength": 1
          },
          "attestedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "platformEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platformEvidence"
      }
    }
  },
  "$defs": {
    "versionText": {
      "type": "string",
      "minLength": 1
    },
    "versionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraft",
        "neoforge",
        "prism",
        "fixture",
        "java",
        "rust"
      ],
      "properties": {
        "minecraft": {
          "$ref": "#/$defs/versionText"
        },
        "neoforge": {
          "$ref": "#/$defs/versionText"
        },
        "prism": {
          "$ref": "#/$defs/versionText"
        },
        "fixture": {
          "$ref": "#/$defs/versionText"
        },
        "java": {
          "$ref": "#/$defs/versionText"
        },
        "rust": {
          "$ref": "#/$defs/versionText"
        },
        "nix": {
          "$ref": "#/$defs/versionText"
        },
        "devenv": {
          "$ref": "#/$defs/versionText"
        },
        "mise": {
          "$ref": "#/$defs/versionText"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "description": "A digest over an artifact a reader can obtain. The name is a repository-relative path for the same reason a review record's is: a name typed as free text let a digest be recorded against prose, and the gate answered a name it could not resolve with an announced skip rather than a violation.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.[A-Za-z0-9]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "privateCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "description": "A digest over material that never enters the repository, so it binds nothing a reader can recompute and the gate says so rather than checking it. This is the one place an unresolvable name is legitimate, and it is a separate definition so that the distinction is declared rather than inferred from how a name happens to read.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "description": "The independent review a milestone is closed on. Unlike a private capture, a review record must be obtainable by a reader who did not run the review, so its name is a repository-relative path inside the milestone directory and the gate recomputes its digest.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.[A-Za-z0-9]+$",
          "description": "Path to the tracked record, relative to the milestone directory. A title is refused: it names nothing a reader can hash."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "startedAt", "durationMs", "exitStatus", "logSha256"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "argvSha256": {
          "$ref": "#/$defs/sha256",
          "description": "Hash of the NUL-delimited argv executed for this record."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "exitStatus": {
          "type": "integer"
        },
        "logSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "classifiedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "classification"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": ["blocking", "non-blocking"]
        },
        "anchor": {
          "$ref": "#/$defs/symbolAnchor"
        }
      }
    },
    "symbolAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "paths"],
      "description": "The one claim inside a finding that a machine can hold: the named Rust symbol has no caller outside this path set. A finding is prose no measurement takes, so it ages into a false statement in silence; the anchor is what makes that failure loud. Required for M5 onward, without retrofitting earlier recorded evidence.",
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "A Rust item name the finding's own summary names, and which the tracked sources define."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Repository-relative path prefixes. Every tracked Rust source naming the symbol must sit under one of them, or the anchor is stale and the gate says so.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "result", "validation"],
      "properties": {
        "workload": {
          "enum": ["vanilla", "official-atm11"]
        },
        "result": {
          "$ref": "#/$defs/hashedArtifact"
        },
        "validation": {
          "$ref": "#/$defs/privateCapture"
        }
      }
    },
    "platformEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "hardwareProfile",
        "versions",
        "settings",
        "native",
        "commands",
        "baselines"
      ],
      "properties": {
        "platform": {
          "enum": ["linux", "macos"]
        },
        "architecture": {
          "enum": ["x86_64", "aarch64"]
        },
        "hardwareProfile": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "$ref": "#/$defs/versionSet"
        },
        "settings": {
          "type": "object"
        },
        "native": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/baseline"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "linux"
              }
            }
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "x86_64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "macos"
              }
            }
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "aarch64"
              }
            }
          }
        }
      ]
    }
  }
}
