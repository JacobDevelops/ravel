{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:schema:evidence:1",
  "title": "Ravel milestone evidence manifest",
  "description": "Sanitized, reproducible evidence for one milestone gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "milestone",
    "workPackages",
    "revision",
    "versions",
    "environment",
    "inputs",
    "commands",
    "tests",
    "benchmarks",
    "deviations",
    "risks",
    "review",
    "attestations",
    "platformEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "enum": ["synthetic", "native"],
      "description": "Synthetic documents test the contract; only native documents can close a milestone."
    },
    "milestone": {
      "type": "string",
      "pattern": "^M(?:[0-9]|1[0-3])$"
    },
    "workPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M(?:[0-9]|1[0-3])-W(?:0|[1-9][0-9]*)$"
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "changeId", "dirty"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Commit exercised by the recorded commands; it may precede the revision that admits this manifest, and every jj rewrite abandons it, so it records what ran rather than where to find it."
        },
        "changeId": {
          "type": "string",
          "pattern": "^[k-z]{32}$",
          "description": "The change that holds this manifest. Survives every rewrite, and the milestone gate recomputes it against the change that introduced the file."
        },
        "dirty": {
          "type": "boolean",
          "description": "Whether the exercised source tree had uncommitted changes when the commands ran."
        }
      }
    },
    "versions": {
      "$ref": "#/$defs/versionSet"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "hardwareProfile", "settings"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "hardwareProfile": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hashedArtifact"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "lineCoveragePercent"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "lineCoveragePercent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "results"],
      "properties": {
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashedArtifact"
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classifiedFinding"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classifiedFinding"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "independent", "result"],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "result": {
          "enum": ["pass", "fail", "not-required"]
        },
        "record": {
          "$ref": "#/$defs/hashedArtifact"
        }
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "architecture",
          "workloads",
          "statement",
          "attestedBy",
          "attestedAt"
        ],
        "properties": {
          "platform": {
            "enum": ["linux", "macos"]
          },
          "architecture": {
            "enum": ["x86_64", "aarch64"]
          },
          "workloads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["vanilla", "official-atm11", "ravel"]
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "attestedBy": {
            "type": "string",
            "minLength": 1
          },
          "attestedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "platformEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platformEvidence"
      }
    }
  },
  "$defs": {
    "versionText": {
      "type": "string",
      "minLength": 1
    },
    "versionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraft",
        "neoforge",
        "prism",
        "fixture",
        "java",
        "rust",
        "nix",
        "devenv"
      ],
      "properties": {
        "minecraft": {
          "$ref": "#/$defs/versionText"
        },
        "neoforge": {
          "$ref": "#/$defs/versionText"
        },
        "prism": {
          "$ref": "#/$defs/versionText"
        },
        "fixture": {
          "$ref": "#/$defs/versionText"
        },
        "java": {
          "$ref": "#/$defs/versionText"
        },
        "rust": {
          "$ref": "#/$defs/versionText"
        },
        "nix": {
          "$ref": "#/$defs/versionText"
        },
        "devenv": {
          "$ref": "#/$defs/versionText"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "startedAt", "durationMs", "exitStatus", "logSha256"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "argvSha256": {
          "$ref": "#/$defs/sha256",
          "description": "Hash of the NUL-delimited argv executed for this record."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "exitStatus": {
          "type": "integer"
        },
        "logSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "classifiedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "classification"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": ["blocking", "non-blocking"]
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "result", "validation"],
      "properties": {
        "workload": {
          "enum": ["vanilla", "official-atm11"]
        },
        "result": {
          "$ref": "#/$defs/hashedArtifact"
        },
        "validation": {
          "$ref": "#/$defs/hashedArtifact"
        }
      }
    },
    "platformEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "hardwareProfile",
        "versions",
        "settings",
        "native",
        "commands",
        "baselines"
      ],
      "properties": {
        "platform": {
          "enum": ["linux", "macos"]
        },
        "architecture": {
          "enum": ["x86_64", "aarch64"]
        },
        "hardwareProfile": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "$ref": "#/$defs/versionSet"
        },
        "settings": {
          "type": "object"
        },
        "native": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/baseline"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "linux"
              }
            }
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "x86_64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "macos"
              }
            }
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "aarch64"
              }
            }
          }
        }
      ]
    }
  }
}
