{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:schema:pack:1",
  "title": "Ravel pack manifest",
  "description": "A reproducible, exactly pinned composition of Ravel packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "minecraftVersion",
    "ravelVersion",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "minecraftVersion": {
      "type": "string",
      "minLength": 1
    },
    "ravelVersion": {
      "$ref": "#/$defs/version"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "sha256"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "version": {
            "$ref": "#/$defs/version"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "enabledSides": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["client", "integrated-server", "dedicated-server"]
            }
          }
        }
      }
    },
    "configuration": {
      "type": "array",
      "default": [],
      "items": {
        "description": "A per-setting override document for one owner, validated by configuration-override.schema.json. It states values for the settings the pack has an opinion about and is not a replacement configuration file: settings it does not name keep the owner's declared default.",
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "path", "sha256"],
        "properties": {
          "owner": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "declarativeData": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/hashedInput"
      }
    },
    "compiledModules": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/hashedInput"
      }
    },
    "provenance": {
      "$ref": "#/$defs/hashedInput"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$).+(?![\\s\\S])"
    },
    "hashedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
