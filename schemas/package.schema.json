{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:schema:package:1",
  "title": "Ravel package manifest",
  "description": "Metadata validated before a Ravel mod can execute.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "compatibility",
    "sides",
    "authors",
    "license",
    "source",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/modId"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ravel", "minecraft"],
      "properties": {
        "ravel": {
          "$ref": "#/$defs/versionRange"
        },
        "minecraft": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sides": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["client", "integrated-server", "dedicated-server"]
      }
    },
    "dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "resources": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "configurationSchemas": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "savedDataVersions": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX licence expression.",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "files"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceFile"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "sha256"],
      "properties": {
        "record": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "modId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationship", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/modId"
        },
        "relationship": {
          "enum": ["required", "optional", "incompatible", "discouraged"]
        },
        "version": {
          "$ref": "#/$defs/versionRange"
        },
        "sides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["client", "integrated-server", "dedicated-server"]
          }
        },
        "order": {
          "enum": ["before", "after"]
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
