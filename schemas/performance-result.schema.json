{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:schema:performance-result:1",
  "title": "Ravel performance result",
  "description": "Sanitized aggregate for one subject run under one versioned performance profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "captureMode",
    "synthetic",
    "profile",
    "subject",
    "environment",
    "inputs",
    "invalidAttempts",
    "repetitions",
    "aggregate",
    "reproducibility",
    "criteria",
    "overallStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": "initial-v1"
    },
    "captureMode": {
      "enum": ["dry-run", "baseline", "acceptance"]
    },
    "synthetic": {
      "type": "boolean"
    },
    "fixturePurpose": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hashedArtifact"
      }
    },
    "invalidAttempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invalidAttempt"
      }
    },
    "repetitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/repetition"
      }
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "reproducibility": {
      "$ref": "#/$defs/reproducibility"
    },
    "criteria": {
      "$ref": "#/$defs/criteria"
    },
    "officialBaselineComparison": {
      "$ref": "#/$defs/comparison"
    },
    "overallStatus": {
      "enum": ["dry-run", "report-only", "pass", "fail"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "captureMode": {
            "const": "dry-run"
          }
        },
        "required": ["captureMode"]
      },
      "then": {
        "properties": {
          "synthetic": {
            "const": true
          },
          "overallStatus": {
            "const": "dry-run"
          },
          "subject": {
            "properties": {
              "kind": {
                "const": "synthetic"
              }
            }
          },
          "environment": {
            "properties": {
              "platform": {
                "const": "synthetic"
              },
              "architecture": {
                "const": "synthetic"
              }
            }
          },
          "reproducibility": {
            "properties": {
              "metrics": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "dry-run"
                    }
                  }
                }
              },
              "status": {
                "const": "dry-run"
              }
            }
          },
          "criteria": {
            "$ref": "#/$defs/dryRunCriteria"
          }
        },
        "required": ["fixturePurpose"]
      },
      "else": {
        "properties": {
          "synthetic": {
            "const": false
          },
          "subject": {
            "properties": {
              "kind": {
                "enum": ["vanilla", "official-pack", "ravel-pack"]
              },
              "workload": {
                "enum": ["vanilla", "complete-pack"]
              }
            }
          },
          "environment": {
            "properties": {
              "platform": {
                "const": "linux"
              },
              "architecture": {
                "const": "x86_64"
              }
            }
          },
          "repetitions": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": {
                "valid": {
                  "const": true
                },
                "invalidReasons": {
                  "maxItems": 0
                }
              }
            }
          },
          "aggregate": {
            "properties": {
              "validRepetitionCount": {
                "const": 1
              }
            }
          },
          "reproducibility": {
            "properties": {
              "validRepetitions": {
                "const": 1
              },
              "metrics": {
                "maxItems": 0
              },
              "status": {
                "const": "not-applicable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "captureMode": {
            "const": "acceptance"
          }
        },
        "required": ["captureMode"]
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "ravel-pack"
              }
            }
          },
          "overallStatus": {
            "enum": ["pass", "fail"]
          },
          "environment": {
            "properties": {
              "platform": {
                "const": "linux"
              },
              "architecture": {
                "const": "x86_64"
              }
            }
          },
          "criteria": {
            "$ref": "#/$defs/acceptanceCriteria"
          }
        },
        "required": ["officialBaselineComparison"]
      }
    },
    {
      "if": {
        "properties": {
          "captureMode": {
            "const": "baseline"
          }
        },
        "required": ["captureMode"]
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "official-pack"
              }
            }
          },
          "overallStatus": {
            "const": "report-only"
          },
          "criteria": {
            "$ref": "#/$defs/reportOnlyCriteria"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "vanilla"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "workload": {
                "const": "vanilla"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "enum": ["official-pack", "ravel-pack"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "workload": {
                "const": "complete-pack"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "captureMode": {
            "const": "acceptance"
          },
          "overallStatus": {
            "const": "pass"
          }
        },
        "required": ["captureMode", "overallStatus"]
      },
      "then": {
        "properties": {
          "criteria": {
            "$ref": "#/$defs/passingCriteria"
          },
          "reproducibility": {
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "quality": {
      "enum": ["exact", "estimated"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {
          "const": "initial"
        },
        "version": {
          "const": 3
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "workload"],
      "properties": {
        "kind": {
          "enum": ["vanilla", "official-pack", "ravel-pack", "synthetic"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "enum": ["vanilla", "complete-pack", "synthetic"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "hardwareProfileSha256",
        "launchInputSha256",
        "worldSha256",
        "routeSha256"
      ],
      "properties": {
        "platform": {
          "enum": ["linux", "macos", "synthetic"]
        },
        "architecture": {
          "enum": ["x86_64", "aarch64", "synthetic"]
        },
        "hardwareProfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "launchInputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "worldSha256": {
          "$ref": "#/$defs/sha256"
        },
        "routeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "invalidAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "reasons", "collectorOutput"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "collectorOutput": {
          "$ref": "#/$defs/hashedArtifact"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "sampleCount", "median", "p95", "p99"],
      "properties": {
        "quality": {
          "const": "exact"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["measured", "unavailable", "not-applicable"]
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "measured"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["quality"],
            "not": {
              "required": ["reason"]
            }
          },
          "else": {
            "required": ["reason"],
            "not": {
              "required": ["quality"]
            }
          }
        }
      ]
    },
    "repetition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "valid",
        "invalidReasons",
        "startupDurationMs",
        "worldLoadDurationMs",
        "averageFps",
        "frameTimeMs",
        "sustained",
        "integratedServerTickTimeMs",
        "memory",
        "systemMemory",
        "memoryPressure",
        "swap",
        "gpu"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "valid": {
          "type": "boolean"
        },
        "invalidReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "startupDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "worldLoadDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "averageFps": {
          "type": "number",
          "minimum": 0
        },
        "frameTimeMs": {
          "$ref": "#/$defs/distribution"
        },
        "sustained": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windowSeconds",
            "stepSeconds",
            "windowCount",
            "minimumWindowAverageFps",
            "failingWindowCount"
          ],
          "properties": {
            "windowSeconds": {
              "const": 60
            },
            "stepSeconds": {
              "const": 1
            },
            "windowCount": {
              "type": "integer",
              "minimum": 1
            },
            "minimumWindowAverageFps": {
              "type": "number",
              "minimum": 0
            },
            "failingWindowCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "integratedServerTickTimeMs": {
          "$ref": "#/$defs/distribution"
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steadyStateRssMaximumBytes", "transientRssPeakBytes"],
          "properties": {
            "steadyStateRssMaximumBytes": {
              "type": "integer",
              "minimum": 0
            },
            "transientRssPeakBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "systemMemory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "peakUsedBytes"],
          "properties": {
            "availability": {
              "$ref": "#/$defs/availability"
            },
            "peakUsedBytes": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "memoryPressure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "maximumLevel",
            "longestWarningSeconds",
            "sustainedWindowCount"
          ],
          "properties": {
            "availability": {
              "$ref": "#/$defs/availability"
            },
            "maximumLevel": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 2
            },
            "longestWarningSeconds": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "sustainedWindowCount": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "swap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "maximumWindowThroughputBytesPerSecond",
            "longestThrashingSeconds",
            "sustainedWindowCount"
          ],
          "properties": {
            "availability": {
              "$ref": "#/$defs/availability"
            },
            "maximumWindowThroughputBytesPerSecond": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "longestThrashingSeconds": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "sustainedWindowCount": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "peakAllocationBytes"],
          "properties": {
            "availability": {
              "$ref": "#/$defs/availability"
            },
            "peakAllocationBytes": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": ["valid"]
          },
          "then": {
            "properties": {
              "invalidReasons": {
                "maxItems": 0
              },
              "memoryPressure": {
                "properties": {
                  "availability": {
                    "properties": {
                      "status": {
                        "const": "measured"
                      },
                      "quality": {
                        "const": "exact"
                      }
                    }
                  }
                }
              },
              "swap": {
                "properties": {
                  "availability": {
                    "properties": {
                      "status": {
                        "const": "measured"
                      },
                      "quality": {
                        "const": "exact"
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "invalidReasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validRepetitionCount",
        "bestStartupDurationMs",
        "bestWorldLoadDurationMs",
        "medianAverageFps",
        "frameTimeMs",
        "integratedServerTickTimeMs",
        "steadyStateRssMaximumBytes",
        "transientRssPeakBytes",
        "systemMemoryPeakUsedBytes",
        "longestWarningSeconds",
        "longestThrashingSeconds",
        "gpuPeakAllocationBytes"
      ],
      "properties": {
        "validRepetitionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "bestStartupDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "bestWorldLoadDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "medianAverageFps": {
          "type": "number",
          "minimum": 0
        },
        "frameTimeMs": {
          "$ref": "#/$defs/distribution"
        },
        "integratedServerTickTimeMs": {
          "$ref": "#/$defs/distribution"
        },
        "steadyStateRssMaximumBytes": {
          "type": "integer",
          "minimum": 0
        },
        "transientRssPeakBytes": {
          "type": "integer",
          "minimum": 0
        },
        "systemMemoryPeakUsedBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "longestWarningSeconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "longestThrashingSeconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "gpuPeakAllocationBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "spreadMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "minimum",
        "maximum",
        "median",
        "relativeSpreadPercent",
        "limitPercent",
        "status"
      ],
      "properties": {
        "metric": {
          "enum": [
            "average-fps",
            "frame-time-p95",
            "tick-time-p95",
            "steady-state-rss-maximum",
            "transient-rss-peak",
            "startup-duration",
            "world-load-duration"
          ]
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "relativeSpreadPercent": {
          "type": "number",
          "minimum": 0
        },
        "limitPercent": {
          "enum": [10, 15]
        },
        "status": {
          "enum": ["dry-run", "pass", "fail"]
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredValidRepetitions",
        "validRepetitions",
        "formula",
        "metrics",
        "categoricalResultsMatch",
        "status"
      ],
      "properties": {
        "requiredValidRepetitions": {
          "const": 1
        },
        "validRepetitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "formula": {
          "const": "100 * (maximum - minimum) / median"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spreadMetric"
          }
        },
        "categoricalResultsMatch": {
          "type": "boolean"
        },
        "status": {
          "enum": ["dry-run", "pass", "fail", "not-applicable"]
        }
      }
    },
    "completeSpreadMetrics": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "allOf": [
        {
          "$ref": "#/$defs/averageFpsSpread"
        },
        {
          "$ref": "#/$defs/frameP95Spread"
        },
        {
          "$ref": "#/$defs/tickP95Spread"
        },
        {
          "$ref": "#/$defs/steadyRssSpread"
        },
        {
          "$ref": "#/$defs/transientRssSpread"
        },
        {
          "$ref": "#/$defs/startupSpread"
        },
        {
          "$ref": "#/$defs/worldLoadSpread"
        }
      ]
    },
    "singleSpreadMetric": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1
    },
    "averageFpsSpread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "average-fps"
          }
        }
      }
    },
    "frameP95Spread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "frame-time-p95"
          }
        }
      }
    },
    "tickP95Spread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "tick-time-p95"
          }
        }
      }
    },
    "steadyRssSpread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "steady-state-rss-maximum"
          }
        }
      }
    },
    "transientRssSpread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "transient-rss-peak"
          }
        }
      }
    },
    "startupSpread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "startup-duration"
          }
        }
      }
    },
    "worldLoadSpread": {
      "$ref": "#/$defs/singleSpreadMetric",
      "contains": {
        "properties": {
          "metric": {
            "const": "world-load-duration"
          }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed",
        "operator",
        "limit",
        "unit",
        "passingRepetitions",
        "requiredRepetitions"
      ],
      "properties": {
        "status": {
          "enum": ["dry-run", "report-only", "pass", "fail", "not-applicable"]
        },
        "observed": {
          "type": "number",
          "minimum": 0
        },
        "operator": {
          "enum": [
            "greater-than-or-equal",
            "less-than-or-equal",
            "less-than"
          ]
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "frames-per-second",
            "bytes",
            "seconds",
            "percent"
          ]
        },
        "passingRepetitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "requiredRepetitions": {
          "const": 1
        }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sustainedFps",
        "steadyStateRss",
        "transientRss",
        "memoryPressureWarning",
