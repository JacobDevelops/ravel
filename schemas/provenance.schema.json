{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ravel:schema:provenance:1",
  "title": "Ravel provenance record",
  "description": "Package-format source, rights, implementation, permission, and attribution metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subject",
    "implementationMethod",
    "sources",
    "rights",
    "attribution",
    "publication"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "enum": ["ravel-package", "pack", "asset", "fixture", "other"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "originalProject": {
          "type": "string"
        },
        "originalAuthor": {
          "type": "string"
        }
      }
    },
    "implementationMethod": {
      "enum": [
        "original",
        "source-informed",
        "behaviour-only-clean-room",
        "permission-based",
        "metadata-only",
        "not-applicable"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "locator", "use", "producedBy"],
        "properties": {
          "category": {
            "enum": [
              "source-code",
              "observable-behaviour",
              "documentation",
              "published-api",
              "metadata",
              "asset",
              "permission",
              "other"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "producedBy": {
            "type": "string",
            "minLength": 1
          },
          "accessedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "status"],
        "properties": {
          "surface": {
            "enum": [
              "code",
              "behaviour",
              "textures",
              "models",
              "sounds",
              "names",
              "branding",
              "quests",
              "scripts",
              "other"
            ]
          },
          "status": {
            "enum": [
              "cleared",
              "permission-required",
              "unresolved",
              "prohibited",
              "not-applicable"
            ]
          },
          "basis": {
            "type": "string"
          },
          "permissionReference": {
            "type": "string"
          }
        }
      }
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "notice"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy"],
      "properties": {
        "status": {
          "enum": ["blocked", "private-only", "cleared"]
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
